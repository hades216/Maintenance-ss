# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# KAAMFIX_ADMIN_PASSWORD: Admin password for the /admin dashboard (configure in production/Netlify secrets).
KAAMFIX_ADMIN_PASSWORD="kaamfix-admin-password"

# KAAMFIX_SESSION_SECRET: HMAC secret for signing admin session cookies.
KAAMFIX_SESSION_SECRET="change-me-in-production"
